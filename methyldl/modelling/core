class BaseModel(ABC):
    def __init__(self, config):
        self.config = config
        self.num_labels = config.num_labels

    @abstractmethod
    def initialize_weights(self):
        """Initialize model weights; framework-specific"""
        pass

    @abstractmethod
    def setup_loss(self):
        """Set up the loss function"""
        pass

    @abstractmethod
    def forward(self, *inputs, **kwargs):
        """Forward pass, to be implemented by subclasses"""
        pass

    def check_model_status(self):
        """Check the training mode of model components"""
        # This can be generalized to ensure each part has a `training` attribute
        for name, module in vars(self).items():
            if hasattr(module, 'training'):
                print(f"{name} training mode : {module.training}")

    @abstractmethod
    def load_pretrained(self, path, component):
        """Load weights into a specific component"""
        pass


class ReadClassifier:
    '''
    Implementation of the read classifier head from the original MethylBERT paper
    '''
    def __init__(self, hidden_size, seq_len, framework='pytorch', dropout_prob=0.05, layer_norm_eps=1e-12):
        self.seq_len = seq_len
        self.framework = framework

        if framework == 'pytorch':
            self.model = nn.Sequential(
                nn.Linear((hidden_size + 1) * (seq_len + 1), seq_len + 1),
                nn.Dropout(dropout_prob),
                nn.ReLU(),
                nn.LayerNorm(seq_len + 1, eps=layer_norm_eps),
                nn.Linear(seq_len + 1, 2)
            )
        elif framework == 'tensorflow':
            self.model = tf.keras.Sequential([
                tf.keras.layers.Dense(seq_len + 1, input_shape=((hidden_size + 1) * (seq_len + 1),)),
                tf.keras.layers.Dropout(dropout_prob),
                tf.keras.layers.ReLU(),
                tf.keras.layers.LayerNormalization(epsilon=layer_norm_eps),
                tf.keras.layers.Dense(2)
            ])
        else:
            raise ValueError("Unsupported framework")

    def forward(self, x):
        return self.model(x)
    
    def from_pretrained_read_classifier(self, pretrained_model_name_or_path, device="cpu"):
        try:
            if self.framework == 'tensorflow':
                self.model.load_weights(pretrained_model_name_or_path)
            elif self.framework == 'pytorch':
                self.model.load_state_dict(torch.load(pretrained_model_name_or_path, map_location=device)) 
            print("Weights loaded successfully.")
        except Exception as e:
            print(f"Failed to load weights from {pretrained_model_name_or_path}: {e}")

